# Copy to android/keystore.properties (gitignored) for release builds.
# Generate a keystore:
#   keytool -genkeypair -v -storetype PKCS12 -keystore spendwise-upload.keystore \
#     -alias spendwise -keyalg RSA -keysize 2048 -validity 10000
#
# Play Console needs the upload key — never commit the real keystore or passwords.

storeFile=spendwise-upload.keystore
storePassword=your-store-password
keyAlias=spendwise
keyPassword=your-key-password
