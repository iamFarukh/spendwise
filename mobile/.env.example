# Copy from web/.env.local or run: npm run sync-env --workspace=@pfos/mobile
# Same Firebase project as web — register Android + iOS apps in Firebase Console.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google Sign-In (Android) — Web client ID from Firebase Console → Authentication → Google
GOOGLE_WEB_CLIENT_ID=966953659387-4qqdf47rnp92jpdf9b7gplhsu8jtf754.apps.googleusercontent.com

# Production web URLs (optional — defaults to spendwise-webapp.vercel.app)
PRIVACY_POLICY_WEB_URL=https://spendwise-webapp.vercel.app/privacy
APP_LOGIN_URL=https://spendwise-webapp.vercel.app/login
APP_DASHBOARD_URL=https://spendwise-webapp.vercel.app/dashboard

# Crash reporting (optional — install @sentry/react-native when enabling)
# Copy DSN from Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# Set to true only when debugging Sentry itself (verbose native logs in LogBox)
# SENTRY_DEBUG=true
